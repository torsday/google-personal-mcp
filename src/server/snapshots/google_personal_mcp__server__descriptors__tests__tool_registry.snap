        "thread_ids": {
          "description": "List of Gmail thread IDs to archive (1–100).",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "account",
        "thread_ids"
      ],
      "type": "object"
    },
    "name": "batch_archive"
  },
