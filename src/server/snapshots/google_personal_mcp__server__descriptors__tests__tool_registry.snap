          "type": "string"
        }
      },
      "required": [
        "account",
        "thread_id"
      ],
      "type": "object"
    },
    "name": "archive_thread"
  },
  {
    "description": "Archive multiple threads in parallel (remove INBOX label from each). Implemented as N concurrent threads.modify calls (10 quota units each). Accepts 1–100 thread IDs. Never short-circuits: returns per-item ok/error for every id. dry_run: true returns ok: true for all ids without making any Gmail calls.",
    "input_schema": {
      "properties": {
        "account": {
          "description": "The account alias from accounts.toml.",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "description": "If true, returns ok: true for all ids without making any Gmail calls.",
