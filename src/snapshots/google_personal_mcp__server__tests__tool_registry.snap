  {
    "description": "Add and/or remove arbitrary labels on a single Gmail thread. Calls threads.modify (10 quota units). At least one of add_label_ids or remove_label_ids must be non-empty. Returns the thread's label_ids after the change, as reported by Gmail. dry_run: true returns applied: false without making any Gmail API call.",
    "input_schema": {
      "properties": {
        "account": {
          "description": "The account alias from accounts.toml.",
          "type": "string"
        },
        "add_label_ids": {
          "description": "Label IDs to add (e.g. [\"STARRED\", \"Label_123\"]).",
